<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme using androidx.core:core-splashscreen -->
    <style name="Theme.ShrinkIt.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.ShrinkIt</item>
    </style>

    <style name="Theme.ShrinkIt" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
