# Release signing for ShrinkIt Android.
#
# 1. Generate an upload keystore ONCE on your own machine (never share it):
#      keytool -genkeypair -v -keystore shrinkit-upload.jks \
#        -keyalg RSA -keysize 2048 -validity 10000 -alias shrinkit-upload
#
# 2. Copy this file to "keystore.properties" (same folder as this template)
#    and fill in the values. keystore.properties is git-ignored and must
#    NEVER be committed. Keep a backup of shrinkit-upload.jks somewhere safe —
#    losing it means you can never update the app on Google Play again.
#
# 3. Run:  ./gradlew bundleRelease
#    The AAB lands in app/build/outputs/bundle/release/app-release.aab,
#    signed with your upload key.

storeFile=shrinkit-upload.jks
storePassword=CHANGE_ME
keyAlias=shrinkit-upload
keyPassword=CHANGE_ME
